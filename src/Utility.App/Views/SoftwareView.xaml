<UserControl x:Class="Utility.App.Views.SoftwareView" Foreground="{StaticResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls">
    <Grid Margin="0,0,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xE71D;" />
                <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr NavSoftware}" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Style="{StaticResource PillTabControlStyle}">
            <!-- Installed software with uninstall + leftover check (own CleanupViewModel instance) -->
            <TabItem Header="{loc:Tr TabInstalledApps}">
                <Grid DataContext="{Binding UninstallContext}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource TableCardStyle}" Margin="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Tag="&#xE72C;" Content="{loc:Tr CleanupRefreshApps}" Command="{Binding RefreshAppsCommand}" Margin="0,0,8,0" />
                                    <Button Content="{loc:Tr CleanupScanLeftovers}" Command="{Binding ScanResidualCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE74D;" Content="{loc:Tr CleanupUninstallSelected}" Command="{Binding UninstallCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="260">
                                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="32,6,8,6"
                                                 AutomationProperties.Name="{loc:Tr CleanupSearchApps}" ToolTip="{loc:Tr CleanupSearchApps}" />
                                        <TextBlock Style="{StaticResource IconStyle}" FontSize="13" HorizontalAlignment="Left" Margin="11,0,0,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE721;" IsHitTestVisible="False" />
                                    </Grid>
                                    <CheckBox Style="{StaticResource ToggleSwitchStyle}" Margin="18,0,0,0" VerticalAlignment="Center"
                                              Content="{loc:Tr ShowComponents}" ToolTip="{loc:Tr TipShowComponents}"
                                              IsChecked="{Binding ShowComponents, Mode=TwoWay}" />
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding ComponentSummary}" />
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                            <DataGrid ItemsSource="{Binding AppRows}" SelectedItem="{Binding SelectedApp}"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <!-- One click ticks or clears the app; ticked apps are uninstalled together. -->
                                    <DataGridTemplateColumn Header="{loc:Tr CleanupSelectColumn}" Width="60" SortMemberPath="Selected">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{loc:Tr ColName}" Width="2.4*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                                           Loaded="OnAppIconLoaded" DataContextChanged="OnAppIconContextChanged">
                                                    <Grid Width="22" Height="22" Margin="0,0,8,0">
                                                        <TextBlock Text="&#xECAA;" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Detail}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Tr ColPublisher}" Binding="{Binding Publisher}" Width="1.4*" />
                                    <DataGridTextColumn Header="{loc:Tr ColVersion}" Binding="{Binding Version}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Tr CleanupAppType}" Binding="{Binding Type}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                                <!-- Empty state: nothing matches the search (shown once the list has loaded) -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding AppRows.Count}" Value="0" />
                                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource IconStyle}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE721;" />
                                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{loc:Tr EmptyNoApps}" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{loc:Tr EmptyNoAppsHint}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <ProgressBar Grid.Row="1" Height="3" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Tr TabStartupEntries}">
                <Border Style="{StaticResource TableCardStyle}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,10,10,8">
                            <Button DockPanel.Dock="Right" Tag="&#xE8A7;" Content="{loc:Tr BtnOpenWindowsStartup}" Command="{Binding OpenWindowsStartupCommand}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Content="{loc:Tr ShowScheduledTasks}"
                                          ToolTip="{loc:Tr TipShowScheduledTasks}" IsChecked="{Binding ShowScheduledTasks, Mode=TwoWay}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{Binding ScheduledTaskSummary}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding StartupEntries}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr ColEnabled}" Width="80" SortMemberPath="IsEnabled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr ColName}" Binding="{Binding Name}" Width="1.3*" />
                                <DataGridTextColumn Header="{loc:Tr ColSource}" Binding="{Binding Source, Converter={StaticResource LocalizedEnum}, ConverterParameter=StartupSource}" Width="*" />
                                <DataGridTextColumn Header="{loc:Tr ColTarget}" Binding="{Binding CommandOrTarget}" Width="2.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
