<UserControl x:Class="Utility.App.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <DockPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="{loc:Tr TelemetryHeader}" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource MutedLabelStyle}" VerticalAlignment="Center" Text="{Binding TelemetryTimestampText}" Margin="0,0,12,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Tr BtnManualGpuRefresh}" Command="{Binding ManualRefreshTelemetryCommand}" />
                </StackPanel>
            </DockPanel>

            <CheckBox IsChecked="{Binding PauseGpuOnBattery}" Content="{loc:Tr ChkPauseGpuOnBattery}" Margin="0,0,0,12" />

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblCpuUsage}" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding CpuUsageText}" />
                        <TextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblCpuTemp}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding CpuTempText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblMemoryUsage}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding MemoryUsageText}" />
                        <TextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblFanRpm}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding CpuFanRpmText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GpuFanRpmText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Text="{Binding GpuNameText}" />
                    <UniformGrid Columns="5">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabelStyle}" Text="GPU" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GpuUtilText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabelStyle}" Text="Temp" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GpuTempText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabelStyle}" Text="Power" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GpuPowerText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabelStyle}" Text="VRAM" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding GpuVramText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabelStyle}" Text="P-State" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding GpuPstateText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblDiskActivity}" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DiskActivityText}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblDiskCapacity}" />
                    <DataGrid ItemsSource="{Binding DiskCapacities}" MaxHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Drive" Binding="{Binding DriveLetter}" Width="0.7*" />
                            <DataGridTextColumn Header="Label" Binding="{Binding VolumeLabel}" Width="1.2*" />
                            <DataGridTextColumn Header="Used (GB)" Binding="{Binding UsedGb, StringFormat=F1}" Width="*" />
                            <DataGridTextColumn Header="Total (GB)" Binding="{Binding TotalGb, StringFormat=F1}" Width="*" />
                            <DataGridTextColumn Header="Used %" Binding="{Binding UsedPercent, StringFormat=F1}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
