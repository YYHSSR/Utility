<UserControl x:Class="Utility.App.Views.BatteryView" Foreground="{StaticResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls">
    <!-- Battery and graphics mode share one page. It fits the window; scrolls only if the window is very short. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,6">
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Tag="&#xE72C;" Content="{loc:Tr BtnRefresh}" Command="{Binding RefreshBatteryCommand}" />
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xE83F;" />
                    <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr NavBattery}" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Charge ring -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblChargeLevel}" />
                        <Grid Width="150" Height="150" Margin="0,4,0,10">
                            <ctl:RingGauge Target="{Binding BatteryChargePercent}" StrokeWidth="12" TrackBrush="{StaticResource GaugeTrackBrush}" ValueBrush="{StaticResource GaugeBatteryBrush}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ctl:SelectableTextBlock HorizontalAlignment="Center" Style="{StaticResource MetricLargeStyle}" FontSize="36">
                                    <Run Text="{Binding BatteryChargePercent, Converter={StaticResource PercentText}, Mode=OneWay}" />
                                </ctl:SelectableTextBlock>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource InsetBorderStyle}">
                            <StackPanel>
                                <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblPowerSource}" />
                                <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" FontSize="13.5" Text="{Binding BatteryActivityText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- Details -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr LblBatteryDetails}" Margin="0,0,0,14" />
                            <UniformGrid Columns="2" Margin="-6,-6">
                                <Border Style="{StaticResource InsetBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblBatteryHealth}" />
                                        <ctl:SelectableTextBlock Style="{StaticResource MetricLargeStyle}" FontSize="24" Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}" Text="{Binding BatteryHealthText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblCycleCount}" />
                                        <ctl:SelectableTextBlock Style="{StaticResource MetricLargeStyle}" FontSize="24" Margin="0,4,0,0" Text="{Binding BatteryCycleText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblDesignCapacity}" />
                                        <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding BatteryDesignCapText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InsetBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblFullCapacity}" />
                                        <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding BatteryFullCapText}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Charge mode -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                          IsChecked="{Binding BatteryConservationEnabled}" IsEnabled="{Binding CanSetConservation}"
                                          AutomationProperties.Name="{loc:Tr LblConservationMode}" />
                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource IconStyle}" Foreground="{StaticResource SuccessBrush}" Text="&#xE83E;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <ctl:SelectableTextBlock FontWeight="SemiBold" FontSize="14.5" Text="{loc:Tr LblConservationMode}" />
                                    <ctl:SelectableTextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Text="{Binding BatteryConservationText}"
                                               Visibility="{Binding BatteryConservationText, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                            </DockPanel>
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr MsgBatteryConservationHelp}" TextWrapping="Wrap"
                                       ToolTip="{Binding BatteryRawDetailText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Graphics mode (merged from the former graphics page) -->
            <Border Style="{StaticResource NoticeWarningStyle}" Visibility="{Binding HasPendingGraphicsReboot, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource IconStyle}" Foreground="{StaticResource WarningBrush}" Text="&#xE7BA;" Margin="0,0,10,0" />
                    <ctl:SelectableTextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Text="{loc:Tr MsgRebootRequiredBanner}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Text="{loc:Tr NavGraphics}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,14,0">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" Text="&#xE7F4;" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblEffectiveMode}" />
                                <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding EffectiveGraphicsText}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Grid.Column="1" Margin="0,0,14,0">
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" Background="{StaticResource WarningSoftBrush}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource IconStyle}" FontSize="18" Foreground="{StaticResource WarningBrush}" Text="&#xE823;" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblPendingMode}" />
                                <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" Foreground="{StaticResource WarningBrush}" Text="{Binding PendingGraphicsText}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasGraphicsModes, Converter={StaticResource BoolToVis}}">
                            <ComboBox MinWidth="180" Margin="0,0,10,0" VerticalAlignment="Center" ItemsSource="{Binding GraphicsModes}"
                                      DisplayMemberPath="Description" SelectedItem="{Binding SelectedGraphicsMode}" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE7F4;" Content="{loc:Tr BtnApplyGraphicsMode}"
                                    VerticalAlignment="Center" Command="{Binding ApplyGraphicsModeCommand}" />
                        </StackPanel>
                    </Grid>
                    <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{Binding GraphicsNoteText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding GraphicsNoteText, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
