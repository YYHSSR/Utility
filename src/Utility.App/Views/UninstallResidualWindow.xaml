<Window x:Class="Utility.App.Views.UninstallResidualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Utility.App.Localization"
        Title="{loc:Tr CleanupScanLeftovers}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Width="840" Height="530" MinWidth="600" MinHeight="340"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="AppName" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ScanStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="Progress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextTertiaryBrush}" Text="{loc:Tr CleanupResidualReviewHint}" />

        <Border Grid.Row="2" Style="{StaticResource TableCardStyle}" Margin="0">
            <DataGrid x:Name="Rows" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Tr CleanupSelectColumn}" Width="62" SortMemberPath="Selected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Path}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Tr CleanupPathColumn}" Binding="{Binding Path}" Width="3*" />
                    <DataGridTextColumn Header="{loc:Tr CleanupSizeColumn}" Binding="{Binding Size}" Width="95" />
                    <DataGridTextColumn Header="{loc:Tr CleanupEvidenceColumn}" Binding="{Binding Evidence}" Width="1.4*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="Rescan" DockPanel.Dock="Left" Content="{loc:Tr CleanupScanLeftovers}" Click="OnRescan" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{loc:Tr CleanupCloseReview}"
                    IsCancel="True" />
            <Button x:Name="Clean" DockPanel.Dock="Right" Margin="0,0,8,0" Content="{loc:Tr CleanupDeleteSelected}"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnClean" IsEnabled="False" />
        </DockPanel>
    </Grid>
</Window>
