<UserControl x:Class="Utility.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{loc:Tr DriversHeader}" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblCategory}" Margin="0,0,8,0" />
                    <ComboBox Width="170" ItemsSource="{Binding DriverCategories}" SelectedItem="{Binding SelectedDriverCategory}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="{loc:Tr BtnLenovoDrivers}" Command="{Binding OpenExternalDriverLinkCommand}" CommandParameter="{Binding DriverLinks.Lenovo83JJDriverPage}" Margin="0,0,6,0" />
                    <Button Content="{loc:Tr BtnNvidiaDrivers}" Command="{Binding OpenExternalDriverLinkCommand}" CommandParameter="{Binding DriverLinks.NvidiaDriverPage}" Margin="0,0,6,0" />
                    <Button Content="{loc:Tr BtnWindowsUpdate}" Command="{Binding OpenExternalDriverLinkCommand}" CommandParameter="{Binding DriverLinks.WindowsUpdateUri}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Tr BtnOptionalUpdates}" Command="{Binding OpenExternalDriverLinkCommand}" CommandParameter="{Binding DriverLinks.WindowsOptionalUpdatesUri}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDrivers}" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.9*" />
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*" />
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="1.2*" />
                <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="*" />
                <DataGridTextColumn Header="Date" Binding="{Binding DriverDate}" Width="0.8*" />
                <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="0.8*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{loc:Tr BtnBrowseDriverExe}" Command="{Binding BrowseDriverPackageCommand}" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding DriverPackagePathText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedLabelStyle}" Text="{Binding DriverPackageSha256Text}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding DriverPackageVerdictText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <CheckBox IsChecked="{Binding UserConfirmedPackageLaunch}" Content="{loc:Tr ChkConfirmDriverLaunch}" Margin="0,0,0,8" />
                <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Tr BtnLaunchDriverExe}" Command="{Binding LaunchVerifiedPackageCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
