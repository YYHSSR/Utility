<UserControl x:Class="Utility.App.Views.DriversView" Foreground="{StaticResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls">
    <Grid Margin="0,0,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ctl:SelectableTextBlock VerticalAlignment="Center" Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblCategory}" Margin="0,0,10,0" />
                <ComboBox Width="170" ItemsSource="{Binding DriverCategories}" SelectedItem="{Binding SelectedDriverCategory}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LocalizedEnum}, ConverterParameter=DriverCategory}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE8A7;" Content="{loc:Tr BtnLenovoDrivers}" Margin="12,0,0,0"
                        Command="{Binding OpenExternalDriverLinkCommand}" CommandParameter="{Binding DriverLinks.Lenovo83JJDriverPage}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xE950;" />
                <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr DriversHeader}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource TableCardStyle}">
            <DataGrid ItemsSource="{Binding FilteredDrivers}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr ColCategory}" Binding="{Binding Category, Converter={StaticResource LocalizedEnum}, ConverterParameter=DriverCategory}" Width="0.9*" />
                    <DataGridTextColumn Header="{loc:Tr ColDevice}" Binding="{Binding DeviceName}" Width="2*" />
                    <DataGridTextColumn Header="{loc:Tr ColProvider}" Binding="{Binding ProviderName}" Width="1.2*" />
                    <DataGridTextColumn Header="{loc:Tr ColVersion}" Binding="{Binding DriverVersion}" Width="*" />
                    <DataGridTextColumn Header="{loc:Tr ColDate}" Binding="{Binding DriverDate}" Width="0.8*" />
                    <DataGridTextColumn Header="{loc:Tr ColInf}" Binding="{Binding InfName}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
