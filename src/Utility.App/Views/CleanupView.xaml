<UserControl x:Class="Utility.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls"
             Foreground="{StaticResource TextPrimaryBrush}">
    <!-- DataContext: QuickCleanupViewModel (set in MainWindow.xaml.cs) -->
    <UserControl.Resources>
        <!-- Selectable file table: checkbox, path, size, note -->
        <DataTemplate x:Key="SelectableFilesTable">
            <DataGrid ItemsSource="{Binding}" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Tr CleanupSelectColumn}" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          AutomationProperties.Name="{Binding Path}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Path}" Width="3*" />
                    <DataGridTextColumn Header="{loc:Tr CleanupSizeColumn}" Binding="{Binding Size}" Width="100" />
                    <DataGridTextColumn Header="{loc:Tr CleanupEvidenceColumn}" Binding="{Binding Evidence}" Width="1.3*" />
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <Style x:Key="SectionSummaryStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedLabelStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE74D;"
                    Content="{loc:Tr BtnQuickCleanup}" ToolTip="{loc:Tr TipQuickCleanup}" Command="{Binding QuickCleanupCommand}" />
            <StackPanel Orientation="Horizontal">
                <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xE74D;" />
                <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr NavCleanup}" />
            </StackPanel>
        </DockPanel>

        <!-- Automatic part: memory + cache -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8"
                Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Columns="2">
                    <DockPanel Margin="10,6">
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource MetricIconStyle}" Tag="&#xE964;" Margin="0,0,12,0"
                                        Background="{StaticResource VioletSoftBrush}" Foreground="{StaticResource Accent2Brush}" />
                        <StackPanel VerticalAlignment="Center">
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr QcMemory}" />
                            <ctl:SelectableTextBlock FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding MemoryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="10,6">
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource MetricIconStyle}" Tag="&#xE74D;" Margin="0,0,12,0"
                                        Background="{StaticResource CyanSoftBrush}" Foreground="{StaticResource CyanBrush}" />
                        <StackPanel VerticalAlignment="Center">
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr QcCache}" />
                            <ctl:SelectableTextBlock FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding CacheText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </UniformGrid>
                <ProgressBar Grid.Row="1" Height="3" Margin="10,6,10,2" IsIndeterminate="{Binding IsCleaning}"
                             Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Categories -->
        <Border Grid.Row="2" Style="{StaticResource SegmentHostStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr QcTabSystem}" GroupName="CleanupTabs" Tag="&#xEDA2;"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=system}"
                             Command="{Binding ChangePageCommand}" CommandParameter="system" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr CleanupDuplicates}" GroupName="CleanupTabs" Tag="&#xE8C8;"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=duplicate}"
                             Command="{Binding ChangePageCommand}" CommandParameter="duplicate" />
                <RadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr CleanupLarge}" GroupName="CleanupTabs" Tag="&#xE8A5;"
                             IsChecked="{Binding Page, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=large}"
                             Command="{Binding ChangePageCommand}" CommandParameter="large" />
            </StackPanel>
        </Border>

        <!-- C 盘清理: cleaned temp/cache files + System Restore points -->
        <Grid Grid.Row="3" Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=system}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TableCardStyle}" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,14,0" Text="{loc:Tr QcTempCard}" />
                        <ctl:SelectableTextBlock Style="{StaticResource SectionSummaryStyle}" Text="{Binding TempSummary}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding TempRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Path}" Width="3*" />
                            <DataGridTextColumn Header="{loc:Tr CleanupSizeColumn}" Binding="{Binding Size}" Width="100" />
                            <DataGridTextColumn Header="{loc:Tr ColState}" Binding="{Binding Evidence}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource TableCardStyle}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Tag="&#xEA18;" Content="{loc:Tr QcRestoreLoad}" Command="{Binding LoadRestorePointsCommand}" Margin="0,0,8,0" />
                            <Button Tag="&#xE74D;" Content="{loc:Tr QcRestoreDelete}" Command="{Binding DeleteRestorePointsCommand}" />
                        </StackPanel>
                        <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0,0,14,0" VerticalAlignment="Center" Text="{loc:Tr QcRestoreCard}" />
                        <ctl:SelectableTextBlock Style="{StaticResource SectionSummaryStyle}" Text="{Binding RestoreSummary}" />
                    </DockPanel>
                    <ProgressBar DockPanel.Dock="Top" Height="3" Margin="14,0,14,6" IsIndeterminate="{Binding IsRestoreBusy}"
                                 Visibility="{Binding IsRestoreBusy, Converter={StaticResource BoolToVis}}" />
                    <DataGrid ItemsSource="{Binding RestorePoints}" MaxHeight="200"
                              Visibility="{Binding RestorePoints.Count, Converter={StaticResource EmptyToCollapsed}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr CleanupSelectColumn}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Description}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr ColCreated}" Binding="{Binding Created}" Width="160" />
                            <DataGridTextColumn Header="{loc:Tr ColDescription}" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 重复文件 -->
        <Border Grid.Row="3" Style="{StaticResource TableCardStyle}" Margin="0"
                Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=duplicate}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Tag="&#xE721;" Content="{loc:Tr QcScanDuplicates}" Command="{Binding ScanDuplicatesCommand}" Margin="0,0,8,0" />
                        <Button Content="{loc:Tr QcSelectCopies}" Command="{Binding SelectDuplicateCopiesCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE74D;" Content="{loc:Tr QcDeleteSelected}" Command="{Binding DeleteDuplicatesCommand}" />
                    </StackPanel>
                    <ctl:SelectableTextBlock Style="{StaticResource SectionSummaryStyle}" Text="{Binding DuplicateSummary}" />
                </DockPanel>
                <ProgressBar DockPanel.Dock="Top" Height="3" Margin="14,0,14,6" IsIndeterminate="{Binding IsDuplicateBusy}"
                             Visibility="{Binding IsDuplicateBusy, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding DuplicateRows}" ContentTemplate="{StaticResource SelectableFilesTable}" />
            </DockPanel>
        </Border>

        <!-- 大文件: one card per fixed drive; a drive is scanned only after its switch is on -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Page, Converter={StaticResource EqualsToVis}, ConverterParameter=large}">
            <StackPanel>
                <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Margin="2,0,0,10" Text="{Binding LargeThresholdText}" />
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                                  Content="{loc:Tr QcScanDrive}" IsChecked="{Binding IsEnabled}" />
                                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource MetricIconStyle}" Tag="&#xEDA2;" Margin="0,0,14,0"
                                                        Background="{StaticResource CyanSoftBrush}" Foreground="{StaticResource CyanBrush}" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                            <DockPanel>
                                                <ctl:SelectableTextBlock DockPanel.Dock="Right" Style="{StaticResource MutedLabelStyle}" Text="{Binding UsageText}" />
                                                <ctl:SelectableTextBlock FontWeight="SemiBold" FontSize="14.5" Text="{Binding Title}" />
                                            </DockPanel>
                                            <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{StaticResource CyanBrush}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="{loc:Tr QcSelectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE74D;" Content="{loc:Tr QcDeleteSelected}" Command="{Binding DeleteSelectedCommand}" />
                                            </StackPanel>
                                            <ctl:SelectableTextBlock Style="{StaticResource SectionSummaryStyle}" Text="{Binding Summary}" />
                                        </DockPanel>
                                        <ProgressBar Height="3" Margin="0,0,0,6" IsIndeterminate="{Binding IsBusy}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"
                                                Visibility="{Binding Rows.Count, Converter={StaticResource EmptyToCollapsed}}">
                                            <ContentControl MaxHeight="320" Content="{Binding Rows}" ContentTemplate="{StaticResource SelectableFilesTable}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
