<UserControl x:Class="Utility.App.Views.FanCurvesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Tr FanHeader}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Text="{Binding FanStatusBannerText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Tr BtnReadFanTable}" Command="{Binding ReadFanTableCommand}" Margin="0,0,8,6" />
                        <Button Content="{loc:Tr MsgFanAddPoint}" Command="{Binding AddFanPointCommand}" Margin="0,0,8,6" />
                        <Button Content="{loc:Tr BtnApplyFanCurve}" Command="{Binding ApplyFanCurveCommand}" Margin="0,0,8,6" />
                        <Button Content="{loc:Tr BtnRestoreFanDefault}" Command="{Binding RestoreDefaultFanCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding FanPoints}" IsReadOnly="False" CanUserAddRows="False" MaxHeight="240" Margin="0,0,12,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Temp (C)" Binding="{Binding TemperatureC, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Speed" Binding="{Binding FanSpeedValue, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding SpeedUnit}" IsReadOnly="True" Width="0.7*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1">
                        <Border Background="{StaticResource BgPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Canvas Width="420" Height="180" ClipToBounds="True">
                                <Line X1="0" Y1="45" X2="420" Y2="45" Stroke="#242C3D" StrokeThickness="1" />
                                <Line X1="0" Y1="90" X2="420" Y2="90" Stroke="#242C3D" StrokeThickness="1" />
                                <Line X1="0" Y1="135" X2="420" Y2="135" Stroke="#242C3D" StrokeThickness="1" />
                                <Polyline Points="{Binding FanPreviewPoints}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" />
                            </Canvas>
                        </Border>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedLabelStyle}" Text="{Binding FanValidationText}" TextWrapping="Wrap" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Preview" Command="{Binding ValidateFanPreviewCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
