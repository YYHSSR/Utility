<UserControl x:Class="Utility.App.Views.DashboardView" Foreground="{StaticResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls">
    <UserControl.Resources>
        <Style x:Key="GaugeCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="16,16,16,14" />
        </Style>
        <Style x:Key="ReadingRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="2,6,2,0" />
        </Style>
        <Style x:Key="ReadingValueStyle" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="GaugeValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricLargeStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="26" />
        </Style>
    </UserControl.Resources>

    <!-- Single-screen layout (no page scrolling): fixed rows on top, the trend/storage row takes the rest. -->
    <Grid Margin="0,0,8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
        </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE72C;"
                        Content="{loc:Tr BtnRefreshAll}" Command="{Binding RefreshAllCommand}" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource MutedLabelStyle}" ToolTip="{loc:Tr LblLastUpdated}" Text="{Binding TelemetryTimestampText}" />
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xE80F;" />
                    <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr HomeTitle}" />
                </StackPanel>
            </DockPanel>

            <!-- Hero: live mode, profile switch and cooling actions in one row -->
            <Border Grid.Row="1" CornerRadius="14" Padding="22,16" Margin="0,0,0,12" Background="{StaticResource HeroGradientBrush}"
                    BorderBrush="{StaticResource HeroBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <!-- Label like the other two columns; the raw mode text only appears when it is not one of the two profiles (e.g. 需管理员) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Foreground="{StaticResource HeroMutedBrush}" Text="{loc:Tr LblPerformanceMode}" />
                            <ctl:SelectableTextBlock Margin="8,0,0,0" Foreground="{StaticResource HeroMutedBrush}" Text="{Binding LiveThermalModeText}">
                                <ctl:SelectableTextBlock.Style>
                                    <Style TargetType="ctl:SelectableTextBlock" BasedOn="{StaticResource MutedLabelStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveProfileId}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctl:SelectableTextBlock.Style>
                            </ctl:SelectableTextBlock>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Border Style="{StaticResource SegmentHostStyle}" Background="#B3FFFFFF" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:StateRadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr ProfileDailyName}" Tag="&#xE706;"
                                                 IsChecked="{Binding ActiveProfileId, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=daily}"
                                                 Command="{Binding ApplyProfilePowerCommand}" CommandParameter="daily" />
                                    <ctl:StateRadioButton Style="{StaticResource SegmentStyle}" Content="{loc:Tr ProfileGamingName}" Tag="&#xE7FC;"
                                                 IsChecked="{Binding ActiveProfileId, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=gaming}"
                                                 Command="{Binding ApplyProfilePowerCommand}" CommandParameter="gaming" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Tr BtnCooling}" Tag="&#xE9CA;" ToolTip="{loc:Tr TipCooling}"
                                    Command="{Binding StartCoolingCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="{loc:Tr BtnStopCooling}" Tag="&#xE71A;" Background="#CCFFFFFF" VerticalAlignment="Center"
                                    Command="{Binding StopCoolingCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource HeroDividerBrush}" BorderThickness="1,0,0,0" Padding="20,0,12,0">
                        <StackPanel VerticalAlignment="Center">
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Foreground="{StaticResource HeroMutedBrush}" Text="{loc:Tr LblWindowsPowerMode}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding LiveWindowsPowerModeText}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource HeroDividerBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Foreground="{StaticResource HeroMutedBrush}" Text="{loc:Tr LblPowerSource}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ctl:SelectableTextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding LiveAcStateText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" Foreground="{StaticResource HeroMutedBrush}" Margin="0,6,0,0" Text="{Binding BatteryConservationText}"
                                       Visibility="{Binding BatteryConservationText, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Gauges: ring + two readings each -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="-7,0">
                <Border Style="{StaticResource GaugeCardStyle}" Margin="7,0,7,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE950;" />
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblCpu}" />
                        </DockPanel>
                        <Grid Width="92" Height="92" Margin="0,8,0,6">
                            <ctl:RingGauge Target="{Binding CpuUsagePercent}" StrokeWidth="9" TrackBrush="{StaticResource GaugeTrackBrush}" ValueBrush="{StaticResource GaugeCpuBrush}" />
                            <ctl:SelectableTextBlock Style="{StaticResource GaugeValueStyle}" VerticalAlignment="Center" Text="{Binding CpuUsagePercent, Converter={StaticResource PercentText}}" />
                        </Grid>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding CpuTempText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblTemperature}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding CpuFanRpmText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblFan}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding CpuPowerText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblPower}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GaugeCardStyle}" Margin="7,0,7,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE7F4;" />
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblGpu}" ToolTip="{Binding GpuNameText}" />
                        </DockPanel>
                        <Grid Width="92" Height="92" Margin="0,8,0,6">
                            <ctl:RingGauge Target="{Binding GpuUtilPercent}" StrokeWidth="9" TrackBrush="{StaticResource GaugeTrackBrush}" ValueBrush="{StaticResource GaugeGpuBrush}" />
                            <ctl:SelectableTextBlock Style="{StaticResource GaugeValueStyle}" VerticalAlignment="Center" Text="{Binding GpuUtilPercent, Converter={StaticResource PercentText}}" />
                        </Grid>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding GpuTempText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblTemperature}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding GpuFanRpmText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblFan}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding GpuPowerText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblPower}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding GpuVramText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblVram}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GaugeCardStyle}" Margin="7,0,7,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE964;" />
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblMemory}" />
                        </DockPanel>
                        <Grid Width="92" Height="92" Margin="0,8,0,6">
                            <ctl:RingGauge Target="{Binding MemoryUsedPercent}" StrokeWidth="9" TrackBrush="{StaticResource GaugeTrackBrush}" ValueBrush="{StaticResource GaugeMemBrush}" />
                            <ctl:SelectableTextBlock Style="{StaticResource GaugeValueStyle}" VerticalAlignment="Center" Text="{Binding MemoryUsedPercent, Converter={StaticResource PercentText}}" />
                        </Grid>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding MemoryShortText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblUsed}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding DiskActivePercent, Converter={StaticResource PercentText}}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblDiskActivity}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GaugeCardStyle}" Margin="7,0,7,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xE83F;" />
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblBattery}" />
                        </DockPanel>
                        <Grid Width="92" Height="92" Margin="0,8,0,6">
                            <ctl:RingGauge Target="{Binding BatteryChargePercent}" StrokeWidth="9" TrackBrush="{StaticResource GaugeTrackBrush}" ValueBrush="{StaticResource GaugeBatteryBrush}" />
                            <ctl:SelectableTextBlock Style="{StaticResource GaugeValueStyle}" VerticalAlignment="Center" Text="{Binding BatteryChargePercent, Converter={StaticResource PercentText}}" />
                        </Grid>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Foreground="{StaticResource SuccessBrush}" Text="{Binding BatteryHealthText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblBatteryHealth}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource ReadingRowStyle}">
                            <ctl:SelectableTextBlock Style="{StaticResource ReadingValueStyle}" Text="{Binding BatteryCycleText}" />
                            <ctl:SelectableTextBlock Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr LblCycleCount}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Trend + storage: fills the remaining height -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" />
                                <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" Margin="5,0,14,0" Text="{loc:Tr LblCpu}" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                                <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" Margin="5,0,0,0" Text="{loc:Tr LblGpu}" />
                            </StackPanel>
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblLiveTrend}" />
                        </DockPanel>
                        <Border MinHeight="80" Background="{StaticResource ChartBgBrush}" CornerRadius="8" ClipToBounds="True">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Text="100%" />
                                    <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="50%" />
                                    <ctl:SelectableTextBlock Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="0%" />
                                </Grid>
                                <Grid Grid.Column="1" Margin="0,5,0,5" ClipToBounds="True">
                                    <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource ChartGridBrush}" />
                                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{StaticResource ChartGridBrush}" />
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource ChartAxisBrush}" />
                                    <ctl:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource SuccessColor}" Capacity="120" />
                                    <ctl:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource AccentColor}" Capacity="120" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" Text="&#xEDA2;" />
                            <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" Text="{loc:Tr LblStorage}" />
                        </DockPanel>
                        <!-- Scrolls inside the card only when there are more drives than fit. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiskCapacities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,12">
                                        <DockPanel>
                                            <ctl:SelectableTextBlock DockPanel.Dock="Right" Style="{StaticResource MutedLabelStyle}">
                                                <Run Text="{Binding UsedGb, StringFormat=F0, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalGb, StringFormat=F0, Mode=OneWay}" /><Run Text=" GB" />
                                            </ctl:SelectableTextBlock>
                                            <ctl:SelectableTextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding DriveLetter, Mode=OneWay}" /><Run Text=" " /><Run Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Normal" Text="{Binding VolumeLabel, Mode=OneWay}" />
                                            </ctl:SelectableTextBlock>
                                        </DockPanel>
                                        <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding UsedPercent, Mode=OneWay}" Foreground="{StaticResource CyanBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
    </Grid>
</UserControl>
