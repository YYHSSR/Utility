<UserControl x:Class="Utility.App.Views.ProfilesView" Foreground="{StaticResource TextPrimaryBrush}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Utility.App.Localization"
             xmlns:ctl="clr-namespace:Utility.App.Controls">
    <!-- Compact rows so the whole page fits the window like the battery page; scrolls only if the window is very short. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,6">
            <!-- Header -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource PageIconStyle}" Tag="&#xEC4A;" />
                    <ctl:SelectableTextBlock Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" Text="{loc:Tr NavProfiles}" />
                </StackPanel>
            </DockPanel>

            <!-- Power parameters -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHostStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="ProfileEdit" Content="{loc:Tr ProfileDailyName}" Tag="&#xE706;"
                                             IsChecked="{Binding SelectedProfileId, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=daily}"
                                             Command="{Binding SelectProfileCommand}" CommandParameter="daily" />
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="ProfileEdit" Content="{loc:Tr ProfileGamingName}" Tag="&#xE7FC;"
                                             IsChecked="{Binding SelectedProfileId, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=gaming}"
                                             Command="{Binding SelectProfileCommand}" CommandParameter="gaming" />
                            </StackPanel>
                        </Border>
                        <ctl:SelectableTextBlock Style="{StaticResource CardHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="{loc:Tr LblPowerParameters}" />
                    </DockPanel>


                    <!-- Column header -->
                    <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <ctl:SelectableTextBlock Grid.Column="0" Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr ColField}" />
                            <ctl:SelectableTextBlock Grid.Column="1" Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr ColDraftValue}" />
                            <ctl:SelectableTextBlock Grid.Column="2" Style="{StaticResource MutedLabelStyle}" Margin="20,0,0,0" Text="{loc:Tr ColReferenceValue}" />
                            <ctl:SelectableTextBlock Grid.Column="3" Style="{StaticResource MutedLabelStyle}" Text="{loc:Tr ColLiveValue}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ProfileFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="8" Padding="10,3" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <ctl:SelectableTextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" Padding="8,3,40,3" />
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource CaptionStyle}" Text="{Binding Unit}" IsHitTestVisible="False" />
                                        </Grid>
                                        <ctl:SelectableTextBlock Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding ReferenceValue}" />
                                        <ctl:SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding LiveReadBackText}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Tag="&#xE74E;" Content="{loc:Tr BtnSaveDraft}" Command="{Binding SaveProfileDraftCommand}" Margin="0,0,10,0" />
                        <Button Tag="&#xE777;" Content="{loc:Tr BtnResetReference}" Command="{Binding ResetProfileToReferenceCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Tag="&#xE768;" Content="{loc:Tr BtnApplyProfilePower}"
                                Command="{Binding ApplyProfilePowerCommand}" Margin="0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
