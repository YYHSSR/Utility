<Window x:Class="Utility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Utility.App.Localization"
        Title="{loc:Tr AppTitle}"
        Icon="pack://application:,,,/Assets/Utility.ico"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{StaticResource BgPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0,12,14">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Margin="6,8,0,14">
                    <Border Width="46" Height="46" CornerRadius="11" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill">
                                <ImageBrush.ImageSource>
                                    <BitmapImage UriSource="pack://application:,,,/Assets/UtilityBrand.png"
                                                 DecodePixelWidth="192" CacheOption="OnLoad" />
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock FontSize="17" FontWeight="Bold" Text="{loc:Tr AppTitle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Device card -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgElevatedBrush}" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Text="&#xE7F8;" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{loc:Tr LblThisDevice}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" Text="{Binding MachineBannerText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- CommandParameter = page index (MainViewModel.Nav*), same order as the TabItems below -->
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xE80F;" Content="{loc:Tr NavHome}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=0}"
                                     Command="{Binding NavigateCommand}" CommandParameter="0" />

                        <TextBlock Style="{StaticResource NavGroupStyle}" Text="{loc:Tr NavGroupControl}" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xEC4A;" Content="{loc:Tr NavProfiles}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=1}"
                                     Command="{Binding NavigateCommand}" CommandParameter="1" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xE83F;" Content="{loc:Tr NavBattery}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=3}"
                                     Command="{Binding NavigateCommand}" CommandParameter="3" />

                        <TextBlock Style="{StaticResource NavGroupStyle}" Text="{loc:Tr NavGroupSystem}" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xE74D;" Content="{loc:Tr NavCleanup}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=5}"
                                     Command="{Binding NavigateCommand}" CommandParameter="5" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xE71D;" Content="{loc:Tr NavSoftware}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=6}"
                                     Command="{Binding NavigateCommand}" CommandParameter="6" />
                        <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Tag="&#xE950;" Content="{loc:Tr NavDrivers}"
                                     IsChecked="{Binding SelectedNavIndex, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=7}"
                                     Command="{Binding NavigateCommand}" CommandParameter="7" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (draggable; caption buttons opt out of chrome hit testing) -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="{loc:Tr TipMinimize}" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="{loc:Tr TipMaximize}" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="{loc:Tr TipClose}" />
                </StackPanel>
            </Grid>

            <!-- Interrupted-operation recovery banner -->
            <Border Grid.Row="1" Style="{StaticResource NoticeWarningStyle}" Margin="28,4,28,0"
                    Visibility="{Binding HasInterruptedOperation, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Tr BtnDismiss}" Command="{Binding DismissInterruptedOperationCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconStyle}" FontSize="18" Foreground="{StaticResource WarningBrush}" Text="&#xE7BA;" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{loc:Tr RecoveryBannerTitle}" />
                        <TextBlock Text="{Binding InterruptedOperationSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pages are created on first navigation. -->
            <Grid x:Name="PageHost" Grid.Row="2" Margin="28,6,20,0" TextElement.FontSize="13">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageOffset" />
                </Grid.RenderTransform>
                <ContentPresenter x:Name="CurrentPage" />
            </Grid>

            <!-- Action toast (bottom centre): shows what an operation did, then fades out on its own (see MainWindow.xaml.cs) -->
            <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="28,0,28,20"
                    MaxWidth="620" Padding="14,10,8,10" CornerRadius="10" Background="{StaticResource ToastBgBrush}"
                    BorderBrush="{StaticResource ToastBorderBrush}" BorderThickness="1"
                    Opacity="0" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="OnToastClick">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastOffset" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#1B2130" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconStyle}" FontSize="14" Foreground="{StaticResource ToastIconBrush}" Text="&#xE73E;" Margin="0,0,10,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconStyle}" FontSize="10" Foreground="{StaticResource ToastMutedBrush}" Text="&#xE8BB;" Margin="14,0,4,0" />
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
