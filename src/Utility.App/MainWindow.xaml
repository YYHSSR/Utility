<Window x:Class="Utility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Utility.App.Localization"
        xmlns:views="clr-namespace:Utility.App.Views"
        Title="{loc:Tr AppTitle}"
        Icon="pack://application:,,,/Assets/Utility.ico"
        Width="1160"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="pack://application:,,,/Assets/Utility.ico" Width="38" Height="38" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="{loc:Tr AppTitle}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding PrivilegeBadgeText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedLabelStyle}" Text="{Binding MachineBannerText}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" IsChecked="True" Content="{loc:Tr NavProfiles}" Command="{Binding NavigateCommand}" CommandParameter="0" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavBattery}" Command="{Binding NavigateCommand}" CommandParameter="1" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavTelemetry}" Command="{Binding NavigateCommand}" CommandParameter="2" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavGraphics}" Command="{Binding NavigateCommand}" CommandParameter="3" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavSoftware}" Command="{Binding NavigateCommand}" CommandParameter="4" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavFanCurves}" Command="{Binding NavigateCommand}" CommandParameter="5" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavDrivers}" Command="{Binding NavigateCommand}" CommandParameter="6" />
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="MainNav" Content="{loc:Tr NavCapabilities}" Command="{Binding NavigateCommand}" CommandParameter="7" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,16,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#3B2A1E" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasInterruptedOperation, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Tr BtnDismiss}" Command="{Binding DismissInterruptedOperationCommand}" Margin="12,0,0,0" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{loc:Tr RecoveryBannerTitle}" />
                        <TextBlock Text="{Binding InterruptedOperationSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedNavIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabItem><views:ProfilesView /></TabItem>
                <TabItem><views:BatteryView /></TabItem>
                <TabItem><views:TelemetryView /></TabItem>
                <TabItem><views:GraphicsView /></TabItem>
                <TabItem><views:SoftwareView /></TabItem>
                <TabItem><views:FanCurvesView /></TabItem>
                <TabItem><views:DriversView /></TabItem>
                <TabItem><views:CapabilitiesView /></TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource MutedLabelStyle}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
